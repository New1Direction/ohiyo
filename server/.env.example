# ── Ohiyo server configuration ────────────────────────────────────────────
# Local dev: copy this to `.env` (cd server && cp .env.example .env).
# Production: set these as your host's secrets/variables (`railway variable set KEY=value`,
# or `fly secrets set KEY=value` on Fly), NOT in a file that is committed (fly.toml, railway.json).

# REQUIRED in production (≥32 chars). Signs session tokens. Release builds REFUSE to
# start without it; dev builds generate an ephemeral secret (sessions reset on every
# restart). Generate one: `openssl rand -base64 48`
JWT_SECRET=

# Optional (≥32 chars). The key two-factor sign-in secrets are encrypted under (via HKDF).
# Unset, they're encrypted under a key derived from JWT_SECRET instead, so rotating
# JWT_SECRET would stop every authenticator app's codes working (recovery codes still
# would). Set this to rotate JWT_SECRET freely. Without either, two-factor sign-in can't be
# turned on. Generate one: `openssl rand -base64 48`
OHIYO_TOTP_KEY=

# REQUIRED in production. Public URL of THIS backend (e.g. https://your-service.up.railway.app).
# It prefixes avatar/banner URLs that are PERSISTED to the database, so an unset or
# wrong value bakes unreachable links in permanently. Release builds refuse to start
# without it; dev defaults to http://localhost:3000.
PUBLIC_BASE_URL=

# Optional CORS allowlist (comma-separated origins). Unset = permissive, which is fine
# for the bearer-token desktop client (auth is via the Authorization header, not
# cookies). To lock down, set e.g.:
#   CORS_ALLOWED_ORIGINS=tauri://localhost,https://tauri.localhost
CORS_ALLOWED_ORIGINS=

# SQLite database location. Local default below; production uses /data on the volume.
DATABASE_URL=sqlite:ohiyo.db

# Address the server binds to.
BIND_ADDR=0.0.0.0:3000

# Log filter.
RUST_LOG=server=info,tower_http=warn

# New accounts allowed per hour from one client address (default 10; 0 = no limit, e.g. for E2E runs).
OHIYO_REGISTER_LIMIT_PER_HOUR=10

# Login attempts allowed per minute for one username, from any address (default 10;
# 0 = no per-username limit, the per-address limit still applies). The limit is checked
# before the password, so an attacker who keeps sending attempts for a username can keep
# that account from logging in for as long as they continue. Existing sessions are not
# affected.
OHIYO_LOGIN_LIMIT_PER_USERNAME_PER_MINUTE=10

# Uploads one account may store in total, in bytes (default 1 GiB).
# MAX_UPLOAD_BYTES_PER_USER=1073741824

# Free disk space uploads must leave alone, in bytes (default 5 GiB; 0 = no guard). Uploads
# and the database share one volume, and a full disk stops the database from writing, so
# once free space is down to this an upload is refused with 507.
# MIN_FREE_DISK_BYTES=5368709120

# Number of reverse proxies in front of this server. On Fly leave it unset (the server
# trusts Fly-Client-IP there). Behind any other proxy set it (usually 1; Railway needs 2,
# because its edge adds its own address after the client's) so rate limits
# use the client's address from X-Forwarded-For instead of the proxy's. Never set it
# when the server is reachable directly: clients could then forge their address.
TRUSTED_PROXY_HOPS=

# Operator accounts: comma-separated user ids. Only these accounts can run Discord
# imports that read local files or use the managed bot, or change an Instant Server's
# tier. Unset = nobody can.
OHIYO_OPERATOR_USER_IDS=

# ── Paid Instant Servers (Stripe) ──────────────────────────────────────────────
# All three or none: without them nobody can buy the paid plan. The plan is also only
# sold where Instant Servers really run (FLY_API_TOKEN set). Point a Stripe webhook at
# https://<this server>/api/v1/billing/stripe/webhook with the events
# checkout.session.completed, checkout.session.async_payment_succeeded and
# customer.subscription.created/updated/deleted/paused/resumed. See GO-LIVE.md §3b.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# A recurring monthly price (about $8 per community).
STRIPE_PRICE_ID=
# The price as the app shows it; keep it in step with STRIPE_PRICE_ID. Default $8/month.
OHIYO_PAID_PRICE_LABEL=
# Where checkout and the billing portal send people back to. Default https://app.ohiyo.gg
OHIYO_APP_URL=

# The only folder the local Discrawl import reads media from. Needed only when
# OHIYO_ENABLE_LOCAL_DISCRAWL_IMPORT is on.
OHIYO_DISCRAWL_MEDIA_ROOT=

# ── Voice (WebRTC TURN/STUN) ──────────────────────────────────────────────────
# Leave the relay settings unset for LAN-only (STUN-only) testing. For real internet
# calls, set up one relay (see DEPLOY.md §2):
#  - Cloudflare Realtime TURN: the TURN key's id and API token from the Cloudflare
#    dashboard (Realtime → TURN Server). The server mints short-lived credentials
#    per call; the token never leaves the server.
#  - or self-hosted coturn (see infra/coturn/): TURN_SECRET must match the coturn
#    `static-auth-secret`.
# TURN_TTL is how long the credentials handed out for one call stay valid.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
TURN_SECRET=
TURN_URLS=
TURN_TTL=86400
STUN_URLS=stun:stun.l.google.com:19302

# ── Link-preview embeds ───────────────────────────────────────────────────────
# When true, the server resolves URLs in messages into Open Graph embed cards
# (off the request path) and persists them. Off by default — it makes outbound
# fetches on your users' behalf, so opt in deliberately.
EMBEDS_ENABLED=false

# ── Full-text search (Meilisearch) ────────────────────────────────────────────
# When enabled, message search uses Meilisearch (see infra/meilisearch/). When
# disabled, search falls back to a SQL LIKE query — no client change either way.
MEILISEARCH_ENABLED=false
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

# ── Voice SFU (LiveKit) ───────────────────────────────────────────────────────
# Optional scalable group-voice path (see infra/livekit/). When disabled, calls
# use the built-in peer-to-peer WebRTC mesh. API key/secret must match livekit.yaml.
LIVEKIT_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# GIF search through KLIPY (https://partner.klipy.com). Without a key the app shows no GIFs tab.
# KLIPY_API_KEY=
