[
  { "why": "plain words are text", "q": "deploy failed", "expect": { "text": ["deploy", "failed"] } },
  { "why": "from: names an author", "q": "from:alice", "expect": { "from": ["alice"] } },
  { "why": "a leading @ and capitals don't matter", "q": "from:@Alice", "expect": { "from": ["alice"] } },
  { "why": "the key can be in capitals", "q": "FROM:bob", "expect": { "from": ["bob"] } },
  { "why": "mentions: takes a dotted name", "q": "mentions:carol.d", "expect": { "mentions": ["carol.d"] } },
  { "why": "in: drops a leading #", "q": "in:#general", "expect": { "in": ["general"] } },
  { "why": "a quoted value keeps its spaces", "q": "in:\"Release Notes\"", "expect": { "in": ["release notes"] } },
  { "why": "has: can repeat", "q": "has:link has:image", "expect": { "has": ["link", "image"] } },
  { "why": "has: kinds in any case", "q": "has:LINK", "expect": { "has": ["link"] } },
  { "why": "an unknown has: kind stays text", "q": "has:gif", "expect": { "text": ["has:gif"] } },
  { "why": "before: takes a date", "q": "before:2026-10-01", "expect": { "before": "2026-10-01" } },
  { "why": "a month that doesn't exist stays text", "q": "before:2026-13-01", "expect": { "text": ["before:2026-13-01"] } },
  { "why": "29 February only in a leap year", "q": "after:2026-02-29", "expect": { "text": ["after:2026-02-29"] } },
  { "why": "29 February in a leap year is a date", "q": "during:2024-02-29", "expect": { "during": "2024-02-29" } },
  { "why": "a date has to be written in full", "q": "before:2026-1-1", "expect": { "text": ["before:2026-1-1"] } },
  { "why": "pinned:true", "q": "pinned:true", "expect": { "pinned": true } },
  { "why": "pinned:false in capitals", "q": "pinned:FALSE", "expect": { "pinned": false } },
  { "why": "pinned: only takes true or false", "q": "pinned:yes", "expect": { "text": ["pinned:yes"] } },
  { "why": "quotes keep a phrase together", "q": "\"exact phrase\" deploy", "expect": { "text": ["exact phrase", "deploy"] } },
  { "why": "a key with nothing after it stays text", "q": "from:", "expect": { "text": ["from:"] } },
  { "why": "an unknown key stays text", "q": "color:red", "expect": { "text": ["color:red"] } },
  { "why": "the same author once", "q": "from:alice from:bob from:ALICE", "expect": { "from": ["alice", "bob"] } },
  { "why": "the last date wins", "q": "before:2026-01-01 before:2026-02-01", "expect": { "before": "2026-02-01" } },
  { "why": "an unclosed quote runs to the end", "q": "deploy \"half open", "expect": { "text": ["deploy", "half open"] } },
  { "why": "filters and text together", "q": "from:alice in:general has:link \"big deploy\" today", "expect": { "text": ["big deploy", "today"], "from": ["alice"], "in": ["general"], "has": ["link"] } },
  { "why": "a link is text, not a filter", "q": "https://example.com/a:b", "expect": { "text": ["https://example.com/a:b"] } },
  { "why": "a quoted filter is text", "q": "\"from:alice\"", "expect": { "text": ["from:alice"] } },
  { "why": "nothing but spaces", "q": "   ", "expect": {} },
  { "why": "a name with a dash and an underscore", "q": "from:a_b-c.d", "expect": { "from": ["a_b-c.d"] } },
  { "why": "in: with only a # stays text", "q": "in:#", "expect": { "text": ["in:#"] } },
  { "why": "a webhook's name, quoted", "q": "from:\"Deploy bot\"", "expect": { "from": ["deploy bot"] } },
  { "why": "tabs and new lines separate words too", "q": "one\ttwo\nthree", "expect": { "text": ["one", "two", "three"] } },
  { "why": "an empty pair of quotes is nothing", "q": "\"\" hi", "expect": { "text": ["hi"] } }
]
