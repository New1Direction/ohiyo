# The backend the packaged desktop app connects to. Release builds (.github/workflows/release.yml)
# read it from here, not from a secret, so the address they ship is the one in the repo.
# This points at the official Ohiyo backend. To self-host instead, deploy the server
# (see DEPLOY.md) and replace the URL with your own server's https address, then rebuild.
VITE_SERVER_URL=https://ohiyo-server-production.up.railway.app
