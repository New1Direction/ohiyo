# Root build context shared by client/Dockerfile and server/Dockerfile.
# Deny by default: only source/build inputs below may leave the checkout.
**
!.dockerignore
!client/
client/**
!client/Dockerfile
!client/railway.json
!client/Caddyfile
!client/package.json
!client/bun.lock
!client/index.html
!client/tsconfig*.json
!client/vite.config.ts
!client/src/
!client/src/**
!client/public/
!client/public/**
!server/
server/**
!server/Dockerfile
!server/railway.json
!server/fly.toml
!server/Cargo.toml
!server/Cargo.lock
!server/docker-entrypoint.sh
!server/litestream-config.sh
!server/src/
!server/src/**
!server/migrations/
!server/migrations/**
!brand/
brand/**
!brand/kikka-chinchilla-clean.png
!.agents/
.agents/**
!.agents/skills/
.agents/skills/**
!.agents/skills/designing-burrow-pages/
.agents/skills/designing-burrow-pages/**
!.agents/skills/designing-burrow-pages/SKILL.md
!.agents/skills/teaching-from-material/
.agents/skills/teaching-from-material/**
!.agents/skills/teaching-from-material/SKILL.md
!.agents/skills/comparing-real-options/
.agents/skills/comparing-real-options/**
!.agents/skills/comparing-real-options/SKILL.md
!.agents/skills/crafting-interactive-stories/
.agents/skills/crafting-interactive-stories/**
!.agents/skills/crafting-interactive-stories/SKILL.md

# Defense in depth even inside allowed source directories.
**/.git
**/.env
**/.env.*
**/node_modules
**/target
**/uploads
**/import-uploads
**/*.db
**/*.db-*
**/*.sqlite*
**/*.log
**/*.tsbuildinfo
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.pfx
**/.DS_Store
# Public Vite build configuration, intentionally committed (never put secrets here).
!client/.env.production
