# Public DNS name, no scheme/path. DNS must reach this host on TCP 80 and 443.
OHIYO_DOMAIN=chat.example.com
# Tag your locally built server/web pair with the tested Git revision.
OHIYO_VERSION=local
# Generate independently with openssl rand -hex 48; keep stable, private and backed up.
JWT_SECRET=
OHIYO_TOTP_KEY=
# Keep >=5 GiB free for SQLite; size the volume accordingly.
MIN_FREE_DISK_BYTES=5368709120
MAX_UPLOAD_BYTES_PER_USER=1073741824
